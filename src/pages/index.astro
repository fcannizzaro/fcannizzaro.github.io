---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogEntry from "../components/BlogEntry.astro";
import ProjectEntry from "../components/ProjectEntry.astro";
import TechGrid from "../components/TechGrid.astro";
import Divider from "../components/Divider.astro";
import Mascot from "../components/Mascot.astro";
import {
    SITE_TITLE,
    SITE_DESCRIPTION,
    GITHUB_URL,
    SITE_AUTHOR,
} from "../consts";
import { fetchRepoData } from "../lib/github";
import { getReadingTime } from "../lib/reading-time";

const posts = (await getCollection("blog"))
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 5);

const projects = (await getCollection("projects"))
    .filter((p) => p.data.featured)
    .sort((a, b) => a.data.order - b.data.order)
    .slice(0, 3);

const repoData = await fetchRepoData(projects.map((p) => p.data.repo));
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
    <section class="home-hero">
        <p class="home-hero__greeting text-text">
            Hi, I'm <strong class="home-hero__name">{SITE_AUTHOR}</strong>.
        </p>
        <div class="home-hero__mascot">
            <Mascot
                directions="/mascots/fcannizzaro-directions.webp"
                reactions="/mascots/fcannizzaro-reactions.webp"
                dockedDirections="/mascots/fcannizzaro-docked-directions.webp"
                dockedReactions="/mascots/fcannizzaro-docked-reactions.webp"
                size={180}
                label="Francesco mascot"
                class="home-hero__mascot-slot"
            />
        </div>
        <p class="home-hero__description text-text-muted text-sm">
            Full Stack Developer. I build open source tools, Stream Deck plugins,
            and developer tooling with TypeScript and Node.js.
        </p>
        <a
            href={GITHUB_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="home-hero__link inline-block text-xs text-text-muted hover:text-text no-underline transition-colors"
        >
            [github.com/fcannizzaro]
        </a>
    </section>

    <Divider title="recent posts" href="/blog/" />

    <section>
        <div class="divide-y divide-border">
            {
                posts.map((post) => (
                    <BlogEntry
                        title={post.data.title}
                        description={post.data.description}
                        pubDate={post.data.pubDate}
                        slug={post.id}
                        minutesRead={getReadingTime(post.body ?? "")}
                    />
                ))
            }
        </div>
    </section>

    <Divider title="tech I work with" />

    <TechGrid />

    <Divider title="projects" href="/projects/" />

    <section>
        <div class="divide-y divide-border">
            {
                projects.map((p) => (
                    <ProjectEntry
                        name={p.data.name}
                        description={p.data.description}
                        slug={p.id}
                        language={p.data.language}
                        stars={repoData[p.data.repo]?.stars ?? 0}
                        status={p.data.status}
                    />
                ))
            }
        </div>
    </section>
</BaseLayout>

<style>
    .home-hero {
        display: grid;
        grid-template-areas:
            "greeting mascot"
            "description description"
            "link link";
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        column-gap: 0.75rem;
        row-gap: 0.75rem;
    }

    .home-hero__greeting {
        grid-area: greeting;
        min-width: 0;
    }

    .home-hero__name {
        display: inline-block;
        padding-inline: 0.08em;
        margin-inline: -0.08em;
        color: var(--color-bg);
        background-color: var(--color-text-heading);
    }

    .home-hero__description {
        grid-area: description;
        max-width: 42rem;
        line-height: 1.65;
    }

    .home-hero__link {
        grid-area: link;
        justify-self: start;
    }

    .home-hero__mascot {
        grid-area: mascot;
        justify-self: end;
    }

    @media (max-width: 639px) {
        :global(.home-hero__mascot-slot),
        :global(.home-hero__mascot-slot .page-mascot) {
            width: 108px !important;
            height: 108px !important;
        }
    }

    @media (max-width: 420px) {
        :global(.home-hero__mascot-slot),
        :global(.home-hero__mascot-slot .page-mascot) {
            width: 92px !important;
            height: 92px !important;
        }
    }

    @media (min-width: 640px) {
        .home-hero {
            grid-template-areas:
                "greeting mascot"
                "description mascot"
                "link mascot";
            grid-template-columns: minmax(0, 1fr) 140px;
            column-gap: 1.5rem;
            row-gap: 0;
        }

        .home-hero__greeting {
            margin-bottom: 0.25rem;
        }

        .home-hero__link {
            margin-top: 0.5rem;
        }
    }
</style>
