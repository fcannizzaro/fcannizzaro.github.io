---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageTitle from "../components/PageTitle.astro";
import TechGrid from "../components/TechGrid.astro";
import Divider from "../components/Divider.astro";
import {
    SITE_TITLE,
    SITE_DESCRIPTION,
    GITHUB_URL,
    PATREON_URL,
    KOFI_URL,
    LINKEDIN_URL,
} from "../consts";
---

<BaseLayout title={`about - ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
    <section class="text-sm space-y-3">
        <p class="text-text">
            I'm <strong class="text-text-heading"
                >Francesco Saverio Cannizzaro</strong
            >, a <strong class="text-text-heading">Full Stack Developer</strong> based
            in
            <strong class="text-text-heading">Italy</strong>.
        </p>
        <p class="text-text-muted">
            I build <strong class="text-text-heading">open source tools</strong
            >,
            <strong class="text-text-heading">Stream Deck plugins</strong>, and
            <strong class="text-text-heading">developer tooling</strong> -- mostly
            with
            <strong class="text-text-heading">TypeScript</strong> and
            <strong class="text-text-heading">Node.js</strong>. I enjoy working
            across the stack, from <strong class="text-text-heading"
                >CLI utilities</strong
            > and desktop integrations to web applications and
            <strong class="text-text-heading">cloud infrastructure</strong>.
        </p>
        <p class="text-text-muted">
            I like experimenting with <strong class="text-text-heading"
                >IoT</strong
            >
            and I'm always exploring <strong class="text-text-heading"
                >new technologies</strong
            >
            and languages -- trying things out is how I learn best.
        </p>
        <p class="text-text-muted">
            I play <strong class="text-text-heading">videogames</strong> quite a bit,
            and some of the plugins and tools I build come directly from that. If
            there's something missing, I'll probably end up building it.
        </p>
        <p class="text-text-muted">
            I also contribute to <strong class="text-text-heading"
                >open source projects</strong
            >
            when I can -- fixing bugs, adding features, or just helping out with projects
            I find interesting.
        </p>
        <p class="text-text-muted">
            Outside of software, I collaborate with the
            <strong class="text-text-heading">GMM</strong> (Giochi Matematici del
            Mediterraneo), a Mediterranean mathematical games competition.
        </p>
    </section>

    <Divider title="tech I work with" />

    <TechGrid />

    <Divider title="links" />

    <section>
        <div class="flex flex-col gap-2 text-sm">
            <a
                href={GITHUB_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="text-text-muted hover:text-text no-underline transition-colors"
            >
                [github]
            </a>
            <a
                href={PATREON_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="text-text-muted hover:text-text no-underline transition-colors"
            >
                [patreon]
            </a>
            <a
                href={KOFI_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="text-text-muted hover:text-text no-underline transition-colors"
            >
                [ko-fi]
            </a>
            <a
                href={LINKEDIN_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="text-text-muted hover:text-text no-underline transition-colors"
            >
                [linkedin]
            </a>
            <span
                class="text-text-muted/40 cursor-not-allowed select-none"
                title="Coming soon"
            >
                [discord]
            </span>
        </div>
    </section>
</BaseLayout>
